# Evito versionar dependências, arquivos temporários e configurações locais.

# Ignoro as dependências que instalo pelo npm.
node_modules/

# Ignoro os arquivos locais e as saídas de compilação do Expo.
.expo/
dist/
web-build/
expo-env.d.ts

# Mantenho fora do Git os arquivos nativos temporários e de assinatura.
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
*.provisionprofile
*.pem
*.der
*.csr
id_rsa
id_ed25519

# Ignoro os arquivos temporários do Metro.
.metro-health-check*

# Ignoro os registros de depuração dos gerenciadores de pacotes.
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Ignoro metadados locais do sistema operacional.
.DS_Store
Thumbs.db

# Protejo os arquivos de ambiente, inclusive .env e .env.production.
.env
.env.*
.envrc
# Versiono apenas modelos que preencho sem senhas ou tokens reais.
!.env.example
!.env.sample
!.env.template

# Mantenho credenciais de build, contas de serviço e tokens fora do Git.
credentials.json
service-account*.json
serviceAccount*.json
*-firebase-adminsdk-*.json
.npmrc
.netrc
.pypirc
.aws/
.ssh/
.secrets/
secrets/

# Ignoro pacotes compilados e cópias locais que podem carregar dados privados.
*.apk
*.aab
*.ipa
*.bak
*.backup
*.swp
*.swo
*~

# Ignoro o cache de compilação do TypeScript.
*.tsbuildinfo

# Ignoro as pastas nativas que podem ser geradas pelo Expo.
/ios
/android
